# Copy this file to .env or set the values in Windows environment variables.
DASHSCOPE_API_KEY=
AUTOPICK_DATA_ROOT=./AutoPickData
# Set to 1 only for UI development without a Qwen key. Never use demo embeddings in production.
AUTOPICK_DEMO_EMBEDDINGS=0
# Retry transient Qwen network/TLS failures for about 90 seconds by default.
AUTOPICK_QWEN_MAX_RETRIES=8
# Show "请接入训练模型" when accumulated valid samples reach this number.
AUTOPICK_TRAINING_FEEDBACK_THRESHOLD=500
